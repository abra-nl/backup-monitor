{
    "name": "abra-nl/backup-monitor",
    "description": "Monitor and trigger spatie/laravel-backup backups from the Statamic Control Panel",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Slinkman",
            "email": "mike@abra.ai"
        }
    ],
    "autoload": {
        "psr-4": {
            "AbraNl\\BackupMonitor\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbraNl\\BackupMonitor\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^4.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0",
        "rector/rector": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Backup Monitor",
            "description": "Backup Monitor addon"
        },
        "laravel": {
            "providers": [
                "AbraNl\\BackupMonitor\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "beta",
    "scripts": {
        "test": "pest",
        "test:unit": "pest tests/Unit --no-coverage",
        "test:feature": "pest tests/Feature --no-coverage",
        "test:coverage": "pest --coverage --min=80 --coverage-html=build/coverage --coverage-clover=build/coverage/clover.xml",
        "pint": "./vendor/bin/pint",
        "pint:check": "./vendor/bin/pint --test",
        "pint:dirty": "./vendor/bin/pint --dirty",
        "stan": "./vendor/bin/phpstan analyse",
        "stan:baseline": "./vendor/bin/phpstan analyse --generate-baseline",
        "rector": "./vendor/bin/rector process",
        "rector:dry": "./vendor/bin/rector process --dry-run",
        "code:check": [
            "@pint:check",
            "@stan",
            "@test"
        ],
        "code:fix": [
            "@pint",
            "@rector",
            "@test"
        ]
    }
}
